# ==============================================================================
# COUPON SUBMISSION & VERIFICATION SYSTEM - ROOT DOCKER COMPOSE PORTS
# ==============================================================================
# Dedicated non-conflicting ports so this project never collides with
# Grihy Inventory Management or other services running on ports 80, 3000, 5000, etc.

# Frontend Docker exposed HTTP Port (default: 8085)
PORT_HTTP=8085

# Backend Port (default: 5055)
BACKEND_PORT=5055

# Security Secrets (Override in production with strong keys)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_coupons_12345
COOKIE_SECRET=super_secret_cookie_signing_key_at_least_32_characters_12345

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:8085,http://localhost:5185

