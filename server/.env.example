# ==============================================================================
# COUPON SUBMISSION & VERIFICATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
PORT=5055
NODE_ENV=development

# Database Configuration (Local Persistent MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27018/coupon_verification_db

# Administrator Default Credentials
ADMIN_NAME=The Nation Pride
ADMIN_EMAIL=thenationpride@admin
ADMIN_PASSWORD=Admin@123456

# Security & Secrets (Use strong random strings in production, min 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_coupons_12345
JWT_EXPIRES_IN=24h
CUSTOMER_SESSION_EXPIRES_IN=2h
COOKIE_SECRET=super_secret_cookie_signing_key_at_least_32_characters_12345

# CORS Configuration (Allowed frontend origins)
CORS_ORIGIN=http://localhost:5185,http://localhost:8085

# Storage Configuration
UPLOAD_DIR=./uploads/coupons
MAX_UPLOAD_SIZE_BYTES=5242880

# Customer Mobile OTP Configuration
ENABLE_DEV_OTP=true
DEV_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# SMS Provider Integration (mock | twilio)
SMS_PROVIDER=mock
